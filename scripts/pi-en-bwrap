  --ro-bind-try /etc/hosts /etc/hosts
  --ro-bind-try /etc/resolv.conf /etc/resolv.conf
  --ro-bind-try /etc/ssl/certs /etc/ssl/certs
  --ro-bind-try /etc/ca-certificates /etc/ca-certificates
  --ro-bind-try /etc/pki /etc/pki
  --ro-bind-try /usr/local/bin /usr/local/bin
  --ro-bind-try /usr/local/lib/node_modules/@earendil-works/pi-coding-agent /usr/local/lib/node_modules/@earendil-works/pi-coding-agent
  "${runtime_shell_args[@]}"
  --bind "$project_root" /workspace
  "${coord_remote_bind_args[@]}"
  "${role_manager_bind_args[@]}"
  --bind "$state_base/home" /home/pi
  --bind "$state_base/agent" /home/pi/.pi/agent
  "${agent_bin_shadow_bind_args[@]}"
  "${extension_bind_args[@]}"
  "${session_bind_args[@]}"
  "${coord_bind_args[@]}"
  --bind "$state_base/cache" /home/pi/.cache
  "${host_ro_bind_args[@]}"
  --chdir "$inside_cwd"
  --setenv HOME /home/pi
  --setenv SHELL /bin/bash
  --setenv USER pi
  --setenv LOGNAME pi
  --setenv PWD "$inside_cwd"
  --setenv PI_CODING_AGENT_DIR /home/pi/.pi/agent
  --setenv PI_CODING_AGENT_SESSION_DIR /home/pi/.pi/agent/sessions
  --setenv PI_EN_INSIDE_SANDBOX 1
  --setenv XDG_CACHE_HOME /home/pi/.cache
  --setenv PYTHONPYCACHEPREFIX /home/pi/.cache/python-bytecode
  --setenv TMPDIR /tmp
  --setenv PATH "$sandbox_path"
  --setenv SSL_CERT_FILE "${PI_EN_BWRAP_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
  --setenv NIX_SSL_CERT_FILE "${PI_EN_BWRAP_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
  --setenv GIT_CONFIG_NOSYSTEM 1
  --setenv PI_SKIP_VERSION_CHECK "${PI_SKIP_VERSION_CHECK:-1}"
  --setenv PI_TELEMETRY "${PI_TELEMETRY:-0}"
)

if [ "${PI_EN_BWRAP_NET:-1}" = "1" ]; then
  bwrap_args+=(--share-net)
fi

if [ "$shell_mode" = "1" ]; then
  exec "$pi_bwrap_bwrap" \
    "${env_args[@]}" \
    "${bwrap_args[@]}" \
    -- "$sandbox_bash" "${pi_args[@]}"
fi

exec "$pi_bwrap_bwrap" \
  "${env_args[@]}" \
  "${bwrap_args[@]}" \
  -- "$sandbox_bash" -lc 'exec pi "$@"' pi "${pi_args[@]}"
