validated_extra_path=""
append_validated_extra_path() {
  if [ -z "$validated_extra_path" ]; then
    validated_extra_path="$1"
  else
    validated_extra_path="$validated_extra_path:$1"
  fi
}

validated_host_extra_path=""
host_extra_bind_args=()
host_ro_bind_args=()
append_validated_host_extra_path() {
  if [ -z "$validated_host_extra_path" ]; then
    validated_host_extra_path="$1"
  else
    validated_host_extra_path="$validated_host_extra_path:$1"
  fi
}

if [ -n "${PI_EN_BWRAP_EXTRA_PATH:-}" ]; then
  old_ifs="$IFS"
  IFS=:
  for extra_path_entry in $PI_EN_BWRAP_EXTRA_PATH; do
    IFS="$old_ifs"
    [ -n "$extra_path_entry" ] || { IFS=:; continue; }
    case "$extra_path_entry" in
      /*) ;;
      *)
        echo "pi-en-bwrap: unsafe PI_EN_BWRAP_EXTRA_PATH entry is not absolute: $extra_path_entry" >&2
        exit 2
        ;;
    esac
    if [ ! -d "$extra_path_entry" ]; then
      echo "pi-en-bwrap: unsafe PI_EN_BWRAP_EXTRA_PATH entry is not an existing directory: $extra_path_entry" >&2
      exit 2
    fi
    canonical_extra_path="$(realpath "$extra_path_entry")"
    case "$canonical_extra_path" in
      /nix/store/*)
        append_validated_extra_path "$canonical_extra_path"
        ;;
      *)
        echo "pi-en-bwrap: unsafe PI_EN_BWRAP_EXTRA_PATH entry outside /nix/store: $extra_path_entry -> $canonical_extra_path" >&2
        exit 2
        ;;
    esac
    IFS=:
  done
  IFS="$old_ifs"
fi

if [ -n "${PI_EN_BWRAP_HOST_EXTRA_PATH:-}" ]; then
  if [ "$host_runtime" != "1" ]; then
    echo "pi-en-bwrap: PI_EN_BWRAP_HOST_EXTRA_PATH is only supported in host runtime mode." >&2
    exit 2
  fi
  old_ifs="$IFS"
  IFS=:
  for host_extra_path_entry in $PI_EN_BWRAP_HOST_EXTRA_PATH; do
    IFS="$old_ifs"
    [ -n "$host_extra_path_entry" ] || { IFS=:; continue; }
    case "$host_extra_path_entry" in
      /*) ;;
      *)
        echo "pi-en-bwrap: unsafe PI_EN_BWRAP_HOST_EXTRA_PATH entry is not absolute: $host_extra_path_entry" >&2
        exit 2
        ;;
    esac
    if [ ! -d "$host_extra_path_entry" ]; then
      echo "pi-en-bwrap: unsafe PI_EN_BWRAP_HOST_EXTRA_PATH entry is not an existing directory: $host_extra_path_entry" >&2
      exit 2
    fi
    canonical_host_extra_path="$(realpath -e "$host_extra_path_entry")"
    if [ -n "$host_home" ]; then
      canonical_host_home="$(realpath -m "$host_home")"
      case "$canonical_host_extra_path" in
        "$canonical_host_home"|"$canonical_host_home"/*)
          echo "pi-en-bwrap: unsafe PI_EN_BWRAP_HOST_EXTRA_PATH entry under host HOME is not mounted by default: $host_extra_path_entry -> $canonical_host_extra_path" >&2
          exit 2
          ;;
      esac
    fi
    append_validated_host_extra_path "$canonical_host_extra_path"
    host_extra_bind_args+=(--ro-bind "$canonical_host_extra_path" "$canonical_host_extra_path")
    IFS=:
  done
  IFS="$old_ifs"
fi

if [ -n "${PI_EN_BWRAP_HOST_RO_PATHS:-}" ]; then
  if [ "$host_runtime" != "1" ]; then
    echo "pi-en-bwrap: PI_EN_BWRAP_HOST_RO_PATHS is only supported in host runtime mode." >&2
    exit 2
  fi
  old_ifs="$IFS"
  IFS=:
  for host_ro_path_entry in $PI_EN_BWRAP_HOST_RO_PATHS; do
    IFS="$old_ifs"
    [ -n "$host_ro_path_entry" ] || { IFS=:; continue; }
    case "$host_ro_path_entry" in
      /*) ;;
      *)
        echo "pi-en-bwrap: unsafe PI_EN_BWRAP_HOST_RO_PATHS entry is not absolute: $host_ro_path_entry" >&2
        exit 2
        ;;
    esac
    if [ ! -e "$host_ro_path_entry" ]; then
      echo "pi-en-bwrap: unsafe PI_EN_BWRAP_HOST_RO_PATHS entry does not exist: $host_ro_path_entry" >&2
      exit 2
    fi
    canonical_host_ro_path="$(realpath -e "$host_ro_path_entry")"
    case "$canonical_host_ro_path" in
      /|/home|/tmp|/var|/usr|/usr/local)
        echo "pi-en-bwrap: unsafe PI_EN_BWRAP_HOST_RO_PATHS entry is too broad: $host_ro_path_entry -> $canonical_host_ro_path" >&2
        exit 2
        ;;
    esac
    host_ro_bind_args+=(--ro-bind "$canonical_host_ro_path" "$canonical_host_ro_path")
    IFS=:
  done
  IFS="$old_ifs"
fi

agent_bin_shadow_bind_args=()
agent_bin_shadow_dir="$state_base/agent-bin-shadow"
agent_bin_shadow_default_tools="rg fd grep find ls bash sh node jq git sed awk tar gzip"
agent_bin_shadow_enabled=0
if [ "$host_runtime" != "1" ] && [ "${PI_EN_BWRAP_AGENT_BIN_SHADOW:-1}" != "0" ]; then
  agent_bin_shadow_enabled=1
fi

agent_bin_shadow_tool_valid() {
  case "$1" in
    ""|*/*|.*|*..*|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.+-]*) return 1 ;;
    *) return 0 ;;
  esac
}

agent_bin_shadow_resolve_tool() {
  local tool="$1" entry candidate old_ifs
  old_ifs="$IFS"
  IFS=:
  for entry in ${PI_EN_RUNTIME_PATH:-}; do
    IFS="$old_ifs"
    [ -n "$entry" ] || { IFS=:; continue; }
    case "$entry" in /*) ;; *) IFS=:; continue ;; esac
    [ -d "$entry" ] || { IFS=:; continue; }
    candidate="$entry/$tool"
    if [ -x "$candidate" ] && candidate="$(realpath -e "$candidate" 2>/dev/null)"; then
      case "$candidate" in /nix/store/*) printf '%s' "$candidate"; IFS="$old_ifs"; return 0 ;; esac
    fi
    IFS=:
  done
  for entry in $validated_extra_path; do
    IFS="$old_ifs"
    [ -n "$entry" ] || { IFS=:; continue; }
    candidate="$entry/$tool"
    if [ -x "$candidate" ] && candidate="$(realpath -e "$candidate" 2>/dev/null)"; then
      case "$candidate" in /nix/store/*) printf '%s' "$candidate"; IFS="$old_ifs"; return 0 ;; esac
    fi
    IFS=:
  done
  IFS="$old_ifs"
  return 1
}

if [ "$agent_bin_shadow_enabled" = "1" ]; then
  agent_bin_shadow_tools="${PI_EN_BWRAP_AGENT_BIN_SHADOW_TOOLS:-$agent_bin_shadow_default_tools}"
  rm -rf "$agent_bin_shadow_dir"
  mkdir -p "$agent_bin_shadow_dir"
  agent_bin_shadow_count=0
  for shadow_tool in $agent_bin_shadow_tools; do
    if ! agent_bin_shadow_tool_valid "$shadow_tool"; then
      echo "pi-en-bwrap: invalid PI_EN_BWRAP_AGENT_BIN_SHADOW_TOOLS entry: $shadow_tool" >&2
      exit 2
    fi
    if shadow_tool_path="$(agent_bin_shadow_resolve_tool "$shadow_tool")"; then
      ln -s "$shadow_tool_path" "$agent_bin_shadow_dir/$shadow_tool"
      agent_bin_shadow_count=$((agent_bin_shadow_count + 1))
    elif [ -n "${PI_EN_BWRAP_AGENT_BIN_SHADOW_TOOLS:-}" ]; then
      echo "pi-en-bwrap: warning: requested agent-bin shadow tool was not found in trusted Nix paths: $shadow_tool" >&2
    fi
  done
  if [ "$agent_bin_shadow_count" -gt 0 ]; then
    agent_bin_shadow_bind_args=(--ro-bind "$agent_bin_shadow_dir" /home/pi/.pi/agent/bin)
  else
    echo "pi-en-bwrap: warning: no agent-bin shadow tools resolved from trusted Nix paths" >&2
  fi
fi

sandbox_path="${PI_EN_RUNTIME_PATH:-}"
sandbox_path="$(append_path_entry "$validated_extra_path" "$sandbox_path")"
if [ "$host_runtime" = "1" ]; then
  sandbox_path="$(append_path_entry "$validated_host_extra_path" "$sandbox_path")"
fi
sandbox_path="$(append_path_entry /usr/local/bin "$sandbox_path")"
sandbox_path="$(append_path_entry /usr/bin "$sandbox_path")"
sandbox_path="$(append_path_entry /bin "$sandbox_path")"

