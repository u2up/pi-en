#!/usr/bin/env bash
set -euo pipefail

append_path_entry() {
  if [ -z "$1" ]; then
    printf '%s' "${2:-}"
  elif [ -z "${2:-}" ]; then
    printf '%s' "$1"
  else
    printf '%s:%s' "$2" "$1"
  fi
}

prepend_path_entry() {
  if [ -z "$1" ]; then
    printf '%s' "${2:-}"
  elif [ -z "${2:-}" ]; then
    printf '%s' "$1"
  else
    printf '%s:%s' "$1" "$2"
  fi
}

if [ -n "${PI_EN_RUNTIME_PATH:-}" ]; then
  export PATH="$(prepend_path_entry "$PI_EN_RUNTIME_PATH" "${PATH:-}")"
fi
DEFAULT_PI_TOOLS="${PI_EN_BWRAP_COMPILED_DEFAULT_TOOLS:-read,bash,edit,write,grep,find,ls}"
if [ -n "${PI_EN_BWRAP_DEFAULT_TOOLS:-}" ]; then
  DEFAULT_PI_TOOLS="$PI_EN_BWRAP_DEFAULT_TOOLS"
fi

usage() {
  cat <<'USAGE'
pi-en-bwrap - run pi-coding-agent inside a rootless bubblewrap sandbox

Usage:
  pi-en-bwrap [pi args...]
  pi-en-bwrap -- [pi args...]
  pi-en-bwrap --shell [--] [bash args...]

Defaults when no pi args are given:
  pi --tools read,bash,edit,write,grep,find,ls --continue

Shell mode enters the same sandbox but execs Bash instead of Pi. With no Bash
arguments it starts an interactive login shell and therefore requires both stdin
and stdout to be TTYs. Use explicit non-interactive Bash arguments such as
-- -lc 'pwd' for non-TTY command evaluation. Use pi-en-shell for normal runtime
selection; use pi-en-bwrap --shell only when the runtime is already selected.

Security model:
  - mounts the detected project root read-write at /workspace
  - mounts /nix/store read-only for devshell tools
  - mounts /usr/local/bin and the global pi npm package read-only when present
  - uses an isolated HOME at /home/pi
  - imports common Pi rules/skills/prompts/roles from the host Pi agent dir by default
  - exposes global Pi extensions/packages from the host Pi agent dir by default
  - copies host Git config into sandbox HOME by default, but not credentials or SSH keys
  - copies host pi auth.json/models.json into sandbox state by default
  - bind-mounts only the host pi sessions for the current working directory by default (disabled for ephemeral homes)
  - does not mount host $HOME, ~/.ssh, cloud credentials, or docker sockets
  - clears the environment, then passes terminal basics and selected LLM provider vars

Environment knobs:
  PI_EN_BWRAP_PROJECT_ROOT=/path   Project to mount; default: git root, else $PWD
  PI_EN_BWRAP_USE_GIT_ROOT=0       Use $PWD instead of auto git-root detection
  PI_EN_BWRAP_STATE_DIR=/path      Persistent sandbox home/config; default: XDG state per project
                                 Use $PWD/.pi-en/state only as explicit project-local opt-in
  PI_EN_BWRAP_EPHEMERAL_HOME=1     Use a temporary sandbox home/config for this run
  PI_EN_BWRAP_IMPORT_AUTH=0        Do not import host ~/.pi/agent auth files
  PI_EN_BWRAP_AUTH_SYNC=missing    Copy auth only if sandbox copy is absent (default: always)
  PI_EN_BWRAP_IMPORT_SESSIONS=0    Do not bind project sessions from host ~/.pi/agent (default: 1, or 0 with ephemeral home)
  PI_EN_BWRAP_HOST_AGENT_DIR=/path Host pi agent dir (default: $PI_CODING_AGENT_DIR or ~/.pi/agent)
  PI_EN_BWRAP_COMMON_AGENT_DIR=/path Common rules/skills/roles dir (default: host pi agent dir)
  PI_EN_BWRAP_IMPORT_COMMON=0       Do not import common AGENTS/SYSTEM files, skills, prompts, or roles
  PI_EN_BWRAP_COMMON_SYNC=missing   Copy common files only if sandbox copy is absent (default: always)
  PI_EN_BWRAP_IMPORT_EXTENSIONS=0   Do not expose global Pi extensions/packages from host agent dir
  PI_EN_BWRAP_EXTENSIONS_SYNC=missing Copy settings.json only if sandbox copy is absent (default: always)
  PI_EN_BWRAP_IMPORT_GIT_CONFIG=0   Do not import host ~/.gitconfig and XDG git config
  PI_EN_BWRAP_GIT_CONFIG_SYNC=missing Copy git config only if sandbox copy is absent (default: always)
  PI_EN_BWRAP_HOST_GITCONFIG=/path  Host global git config (default: ~/.gitconfig)
  PI_EN_BWRAP_HOST_XDG_GIT_CONFIG=/path Host XDG git config (default: $XDG_CONFIG_HOME/git/config or ~/.config/git/config)
  PI_EN_BWRAP_DEFAULT_TOOLS="..."  Override default --tools list
  PI_EN_BWRAP_AGENT_BIN_SHADOW=0 Disable Nix-runtime shadowing of /home/pi/.pi/agent/bin
  PI_EN_BWRAP_AGENT_BIN_SHADOW_TOOLS="rg fd ..."
                               Replace curated Nix shadow tools; missing entries warn,
                               and empty or unresolved lists skip the shadow bind
  PI_EN_BWRAP_EXTRA_PATH=/nix/store/.../bin[:...] Add validated Nix-store command dirs after pi-en runtime tools
  PI_EN_BWRAP_HOST_EXTRA_PATH=/opt/tools/bin[:...] Host runtime only: add validated host command dirs
  PI_EN_BWRAP_HOST_RO_PATHS=/opt/pi-en/share/pi-en/scripts[:...]
                                Host runtime only: bind extra support paths read-only
  PI_EN_BWRAP_NET=0                Disable network namespace sharing
  PI_EN_BWRAP_COORDINATION_DIR=/path Coordination checkout override; automatic workflows
                                require /path to be PROJECT/.pi-en/coordination
  PI_EN_COORD_REMOTE=remote        Coordination Git remote URL or local bare path; project paths
                                 stay under /workspace, external parents bind safely
  PI_EN_COORD_ROLE=architect       Active coordination role passed to helpers
  PI_EN_BWRAP_PASS_ENV="A B,C"     Extra environment variable names to pass through

To pass pi's own -h/--help, use:
  pi-en-bwrap -- --help
USAGE
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

shell_mode=0
if [ "${1:-}" = "--shell" ]; then
  shell_mode=1
  shift
fi

if [ "${1:-}" = "--" ]; then
  shift
fi

pi_host_path=""
if [ "$shell_mode" = "0" ]; then
  pi_host_path="$(command -v pi 2>/dev/null || true)"
  if [ -z "$pi_host_path" ]; then
    echo "pi-en-bwrap: pi was not found on PATH before entering the sandbox." >&2
    echo "Install pi globally, or enter a shell that provides it, then retry." >&2
    exit 127
  fi
  if ! pi_host_path="$(realpath -e "$pi_host_path" 2>/dev/null)"; then
    echo "pi-en-bwrap: resolved host pi path does not exist: $(command -v pi 2>/dev/null || true)" >&2
    exit 127
  fi
fi

resolve_required_tool() {
  local env_name="$1"
  local fallback_name="$2"
  local value="${!env_name:-}"
  if [ -z "$value" ]; then
    value="$(command -v "$fallback_name" 2>/dev/null || true)"
  fi
  if [ -z "$value" ]; then
    echo "pi-en-bwrap: required host tool was not found: $fallback_name" >&2
    exit 127
  fi
  case "$value" in
    /*) ;;
    *)
      echo "pi-en-bwrap: required host tool did not resolve to an absolute path: $fallback_name -> $value" >&2
      exit 127
      ;;
  esac
  if ! value="$(realpath -e "$value" 2>/dev/null)"; then
    echo "pi-en-bwrap: required host tool path does not exist: $fallback_name -> ${!env_name:-$value}" >&2
    exit 127
  fi
  printf '%s' "$value"
}

pi_bwrap_bash="$(resolve_required_tool PI_EN_BWRAP_BASH bash)"
pi_bwrap_env="$(resolve_required_tool PI_EN_BWRAP_ENV env)"
pi_bwrap_bwrap="$(resolve_required_tool PI_EN_BWRAP_BWRAP bwrap)"
host_runtime=0
if [ -z "${PI_EN_RUNTIME_PATH:-}" ]; then
  host_runtime=1
fi
host_home="${HOME:-}"
if [ -n "$host_home" ]; then
  canonical_host_home="$(realpath -m "$host_home")"
else
  canonical_host_home=""
fi

host_path_is_default_mounted() {
  case "$1" in
    /bin/*|/usr/bin/*|/usr/local/bin/*|/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/*|/usr/local/lib/node_modules/@earendil-works/pi-coding-agent) return 0 ;;
    *) return 1 ;;
  esac
}

host_path_is_under_host_extra_path() {
  local path="$1"
  local entry canonical_entry old_ifs
  [ -n "${PI_EN_BWRAP_HOST_EXTRA_PATH:-}" ] || return 1
  old_ifs="$IFS"
  IFS=:
  for entry in $PI_EN_BWRAP_HOST_EXTRA_PATH; do
    IFS="$old_ifs"
    [ -n "$entry" ] || { IFS=:; continue; }
    if canonical_entry="$(realpath -e "$entry" 2>/dev/null)"; then
      case "$path" in
        "$canonical_entry"|"$canonical_entry"/*)
          IFS="$old_ifs"
          return 0
          ;;
      esac
    fi
    IFS=:
  done
  IFS="$old_ifs"
  return 1
}

if [ "$host_runtime" = "1" ]; then
  for host_runtime_tool in "$pi_bwrap_bash" "$pi_bwrap_env"; do
    case "$host_runtime_tool" in
      /nix/store/*)
        echo "pi-en-bwrap: host runtime requires host bash/env tools, but resolved a Nix-store tool: $host_runtime_tool" >&2
        echo "pi-en-bwrap: install host runtime tools, set PI_EN_BWRAP_BASH/PI_EN_BWRAP_ENV to host paths, or use the Nix runtime." >&2
        exit 127
        ;;
    esac
  done

  if [ "$shell_mode" = "0" ] && [ -n "$canonical_host_home" ]; then
    case "$pi_host_path" in
      "$canonical_host_home"|"$canonical_host_home"/*)
        echo "pi-en-bwrap: host runtime resolved pi under host HOME, which is not mounted by default: $pi_host_path" >&2
        echo "pi-en-bwrap: install pi under /usr/local/bin, /usr/bin, or /bin; provide a safe command dir with PI_EN_BWRAP_HOST_EXTRA_PATH; or use --runtime nix." >&2
        exit 127
        ;;
    esac
  fi
  if [ "$shell_mode" = "0" ] && ! host_path_is_default_mounted "$pi_host_path" && ! host_path_is_under_host_extra_path "$pi_host_path"; then
    echo "pi-en-bwrap: host runtime resolved pi outside default sandbox mounts: $pi_host_path" >&2
    echo "pi-en-bwrap: install pi under /usr/local/bin, /usr/bin, or /bin; add its directory with PI_EN_BWRAP_HOST_EXTRA_PATH for a read-only bind; or use --runtime nix." >&2
    exit 127
  fi

  if [ "$shell_mode" = "0" ] && [ -f "$pi_host_path" ] && IFS= read -r pi_shebang <"$pi_host_path"; then
    case "$pi_shebang" in
      *'/usr/bin/env node'*)
        node_path="$(command -v node 2>/dev/null || true)"
        if [ -z "$node_path" ] || ! node_path="$(realpath -e "$node_path" 2>/dev/null)"; then
          echo "pi-en-bwrap: host runtime pi launcher requires node, but node was not found on PATH." >&2
          exit 127
        fi
        case "$node_path" in
          /bin/*|/usr/bin/*|/usr/local/bin/*) ;;
          *)
            echo "pi-en-bwrap: host runtime pi launcher requires node inside the sandbox, but node resolved outside mounted host command dirs: $node_path" >&2
            echo "pi-en-bwrap: install node under /usr/local/bin, /usr/bin, or /bin, or use the Nix runtime." >&2
            exit 127
            ;;
        esac
        ;;
    esac
  fi
fi

project_root="${PI_EN_BWRAP_PROJECT_ROOT:-}"
if [ -z "$project_root" ]; then
  if [ "${PI_EN_BWRAP_USE_GIT_ROOT:-1}" = "1" ] && command -v git >/dev/null 2>&1; then
    project_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  fi
  if [ -z "$project_root" ]; then
    project_root="$PWD"
  fi
fi
project_root="$(realpath -m "$project_root")"
if [ ! -d "$project_root" ]; then
  echo "pi-en-bwrap: project root does not exist: $project_root" >&2
  exit 2
fi

host_cwd="$(realpath -m "$PWD")"
case "$host_cwd" in
  "$project_root")
    inside_cwd="/workspace"
    ;;
  "$project_root"/*)
    inside_cwd="/workspace${host_cwd#"$project_root"}"
    ;;
  *)
    inside_cwd="/workspace"
    ;;
esac

pi_bwrap_trim() {
  printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

pi_bwrap_yaml_unquote() {
  local value first last
  value="$(pi_bwrap_trim "$1")"
  case "$value" in
    ""|null|Null|NULL|~)
      printf '\n'
      return
      ;;
  esac
  first="${value:0:1}"
  last="${value: -1}"
  if [ "$first" = "'" ] && [ "$last" = "'" ] && [ "${#value}" -ge 2 ]; then
    value="${value:1:${#value}-2}"
    value="$(printf '%s' "$value" | sed "s/''/'/g")"
  elif [ "$first" = '"' ] && [ "$last" = '"' ] && [ "${#value}" -ge 2 ]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s\n' "$value"
}

pi_bwrap_coord_config_value() {
  local key file value
  key="$1"
  file="$project_root/.pi-en-coordination.yaml"
  [ -f "$file" ] || return 1
  value="$(awk -v key="$key" '
    /^[[:space:]]*#/ { next }
    index($0, key ":") == 1 {
      sub("^[^:]+:[[:space:]]*", "")
      print
      exit
    }
  ' "$file")"
  value="$(pi_bwrap_yaml_unquote "$value")"
  [ -n "$value" ] || return 1
  printf '%s\n' "$value"
}

pi_bwrap_remote_local_path() {
  local remote
  remote="$1"
  case "$remote" in
    "")
      return 1
      ;;
    file://*)
      printf '%s\n' "${remote#file://}"
      return 0
      ;;
    *://*|*:*)
      return 1
      ;;
    /*|./*|../*|*/*|.*)
      printf '%s\n' "$remote"
      return 0
      ;;
  esac
  return 1
}

if [ "${PI_EN_BWRAP_EPHEMERAL_HOME:-0}" = "1" ]; then
  state_base="$(mktemp -d "${TMPDIR:-/tmp}/pi-en-bwrap.XXXXXX")"
  cleanup_tmp="$state_base"
  trap 'rm -rf "$cleanup_tmp"' EXIT
else
  project_hash="$(printf '%s' "$project_root" | sha256sum | awk '{print $1}' | cut -c1-16)"
  state_parent="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}"
  state_base="${PI_EN_BWRAP_STATE_DIR:-$state_parent/pi-en/$project_hash}"
  state_base="$(realpath -m "$state_base")"
fi

mkdir -p \
  "$state_base/home/.pi/agent" \
  "$state_base/home/.cache" \
  "$state_base/home/.config/git" \
  "$state_base/agent/sessions" \
  "$state_base/cache"
chmod 700 "$state_base" "$state_base/home" "$state_base/home/.pi" "$state_base/home/.cache" "$state_base/home/.config" "$state_base/home/.config/git" "$state_base/agent" "$state_base/agent/sessions" "$state_base/cache" 2>/dev/null || true

host_agent_dir="${PI_EN_BWRAP_HOST_AGENT_DIR:-}"
if [ -z "$host_agent_dir" ] && [ -n "${PI_CODING_AGENT_DIR:-}" ]; then
  host_agent_dir="$PI_CODING_AGENT_DIR"
fi
if [ -z "$host_agent_dir" ] && [ -n "${HOME:-}" ]; then
  host_agent_dir="$HOME/.pi/agent"
fi
if [ -n "$host_agent_dir" ]; then
  host_agent_dir="$(realpath -m "$host_agent_dir")"
fi

common_agent_dir="${PI_EN_BWRAP_COMMON_AGENT_DIR:-$host_agent_dir}"
if [ -n "$common_agent_dir" ]; then
  common_agent_dir="$(realpath -m "$common_agent_dir")"
fi

should_sync_common() {
  local target="$1"
  [ "${PI_EN_BWRAP_COMMON_SYNC:-always}" = "always" ] || [ ! -e "$target" ]
}

if [ "${PI_EN_BWRAP_IMPORT_COMMON:-1}" = "1" ] && [ -n "$common_agent_dir" ] && [ -d "$common_agent_dir" ] && [ "$common_agent_dir" != "$state_base/agent" ]; then
  for common_file in AGENTS.md CLAUDE.md SYSTEM.md APPEND_SYSTEM.md; do
    if [ -f "$common_agent_dir/$common_file" ] && should_sync_common "$state_base/agent/$common_file"; then
      cp -p "$common_agent_dir/$common_file" "$state_base/agent/$common_file"
    fi
  done

  for common_dir_name in skills prompts roles; do
    if [ -d "$common_agent_dir/$common_dir_name" ] && should_sync_common "$state_base/agent/$common_dir_name"; then
      rm -rf "$state_base/agent/$common_dir_name"
      mkdir -p "$state_base/agent"
      cp -a "$common_agent_dir/$common_dir_name" "$state_base/agent/$common_dir_name"
    fi
  done
fi

coordination_context_begin="<!-- pi-en generated coordination context: begin -->"
coordination_context_end="<!-- pi-en generated coordination context: end -->"

strip_generated_coordination_context() {
  local context_file tmp_file
  context_file="$1"
  [ -f "$context_file" ] || return 0
  tmp_file="$context_file.tmp.$$"
  awk -v begin="$coordination_context_begin" -v end="$coordination_context_end" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    !skip { print }
  ' "$context_file" >"$tmp_file"
  if [ -s "$tmp_file" ]; then
    mv "$tmp_file" "$context_file"
  else
    rm -f "$context_file" "$tmp_file"
  fi
}

refresh_generated_coordination_context() {
  local context_file
  context_file="$state_base/agent/AGENTS.md"
  strip_generated_coordination_context "$context_file"

  if [ -d "$host_coord_dir" ] && { [ -d "$host_coord_dir/.git" ] || [ -f "$host_coord_dir/AGENTS.md" ]; }; then
    mkdir -p "$state_base/agent"
    if [ -f "$context_file" ]; then
      printf '\n' >>"$context_file"
    fi
    cat >>"$context_file" <<EOF_COORDINATION_CONTEXT
$coordination_context_begin

## Pi-en coordination context

This Pi session is running through Pi-en with a project-local coordination
checkout at \`$sandbox_coord_dir\` inside the sandbox. When the task involves
coordination items, requirements, decisions, TODOs, generated requirements
documents, reviews, verification, or shared agent state, read and follow
\`$sandbox_coord_dir/AGENTS.md\` before changing coordination state.

Prefer the sandbox-safe helper namespace over hand-editing coordination item
structure or generated outputs when the helpers are available:

- \`pien coord pull\` before reading or changing shared state.
- \`pien coord status\`, \`pien coord list ...\`, and \`pien coord show ITEM\`
  for inspection.
- \`pien coord new\`, \`claim\`, \`done\`, \`review\`, \`verify\`, and \`close\`
  for lifecycle transitions.
- \`pien coord repo ...\` for implementation repo registry changes.
- \`pien coord requirements generate --output REQUIREMENTS.md\` and
  \`pien coord requirements coverage --output REQUIREMENTS_COVERAGE.md\` for
  generated domain requirement views that this implementation repo commits.
- \`pien coord lint --project-root .\` before reporting completion when
  practical.

For generated domain files, update the coordination requirement items first,
then check the current repo manifest at
\`\$PI_EN_COORD_DIR/repos/<repo_id>/REPO.md\`. Regenerate and commit only the
paths listed in \`domain_generated_files\`; ask before touching generated files
that are not declared for this implementation repo.

If \`pien diagnostics\` reports \`coordination_helpers=unavailable\`, or if Git
credentials needed for the coordination remote are not intentionally available
inside the sandbox, report the limitation and ask for an outer-terminal or
credential-enabled workflow instead of silently bypassing the helper-first
protocol.

$coordination_context_end
EOF_COORDINATION_CONTEXT
  fi
}

should_sync_git_config() {
  local target="$1"
  [ "${PI_EN_BWRAP_GIT_CONFIG_SYNC:-always}" = "always" ] || [ ! -e "$target" ]
}

if [ "${PI_EN_BWRAP_IMPORT_GIT_CONFIG:-1}" = "1" ]; then
  host_gitconfig="${PI_EN_BWRAP_HOST_GITCONFIG:-}"
  if [ -z "$host_gitconfig" ] && [ -n "$host_home" ]; then
    host_gitconfig="$host_home/.gitconfig"
  fi
  if [ -n "$host_gitconfig" ]; then
    host_gitconfig="$(realpath -m "$host_gitconfig")"
    if [ -f "$host_gitconfig" ] && should_sync_git_config "$state_base/home/.gitconfig"; then
      cp -p "$host_gitconfig" "$state_base/home/.gitconfig"
      chmod 600 "$state_base/home/.gitconfig" 2>/dev/null || true
    fi
  fi

  host_xdg_git_config="${PI_EN_BWRAP_HOST_XDG_GIT_CONFIG:-}"
  if [ -z "$host_xdg_git_config" ] && [ -n "${XDG_CONFIG_HOME:-}" ]; then
    host_xdg_git_config="${XDG_CONFIG_HOME}/git/config"
  fi
  if [ -z "$host_xdg_git_config" ] && [ -n "$host_home" ]; then
    host_xdg_git_config="$host_home/.config/git/config"
  fi
  if [ -n "$host_xdg_git_config" ]; then
    host_xdg_git_config="$(realpath -m "$host_xdg_git_config")"
    if [ -f "$host_xdg_git_config" ] && should_sync_git_config "$state_base/home/.config/git/config"; then
      mkdir -p "$state_base/home/.config/git"
      cp -p "$host_xdg_git_config" "$state_base/home/.config/git/config"
      chmod 600 "$state_base/home/.config/git/config" 2>/dev/null || true
    fi
  fi
fi

if [ "${PI_EN_BWRAP_IMPORT_AUTH:-1}" = "1" ] && [ -n "$host_agent_dir" ] && [ -d "$host_agent_dir" ]; then
  for auth_file in auth.json models.json; do
    if [ -f "$host_agent_dir/$auth_file" ]; then
      if [ "${PI_EN_BWRAP_AUTH_SYNC:-always}" = "always" ] || [ ! -e "$state_base/agent/$auth_file" ]; then
        cp -p "$host_agent_dir/$auth_file" "$state_base/agent/$auth_file"
        chmod 600 "$state_base/agent/$auth_file" 2>/dev/null || true
      fi
    fi
  done
fi

extension_bind_args=()
should_sync_extensions() {
  local target="$1"
  [ "${PI_EN_BWRAP_EXTENSIONS_SYNC:-always}" = "always" ] || [ ! -e "$target" ]
}

if [ "${PI_EN_BWRAP_IMPORT_EXTENSIONS:-1}" = "1" ] && [ -n "$host_agent_dir" ] && [ -d "$host_agent_dir" ] && [ "$host_agent_dir" != "$state_base/agent" ]; then
  if [ -f "$host_agent_dir/settings.json" ] && should_sync_extensions "$state_base/agent/settings.json"; then
    cp -p "$host_agent_dir/settings.json" "$state_base/agent/settings.json"
    chmod 600 "$state_base/agent/settings.json" 2>/dev/null || true
  fi

  for extension_dir_name in extensions npm git; do
    if [ -d "$host_agent_dir/$extension_dir_name" ]; then
      mkdir -p "$state_base/agent/$extension_dir_name"
      extension_bind_args+=(--ro-bind "$host_agent_dir/$extension_dir_name" "/home/pi/.pi/agent/$extension_dir_name")
    fi
  done
fi

session_bind_args=()
session_dir_for_path() {
  local normalized stripped replaced
  normalized="$(realpath -m "$1")"
  stripped="${normalized#/}"
  replaced="${stripped//\//-}"
  replaced="${replaced//:/-}"
  printf -- '--%s--' "$replaced"
}

import_sessions_default=1
if [ "${PI_EN_BWRAP_EPHEMERAL_HOME:-0}" = "1" ]; then
  import_sessions_default=0
fi

if [ "${PI_EN_BWRAP_IMPORT_SESSIONS:-$import_sessions_default}" = "1" ] && [ -n "$host_agent_dir" ]; then
  host_session_dir_name="$(session_dir_for_path "$host_cwd")"
  sandbox_session_dir_name="$(session_dir_for_path "$inside_cwd")"
  host_project_session_dir="$host_agent_dir/sessions/$host_session_dir_name"
  state_workspace_session_dir="$state_base/agent/sessions/$sandbox_session_dir_name"

  if mkdir -p "$host_project_session_dir" "$state_workspace_session_dir" 2>/dev/null; then
    chmod 700 "$host_agent_dir" "$host_agent_dir/sessions" "$host_project_session_dir" "$state_workspace_session_dir" 2>/dev/null || true
    if [ -d "$state_workspace_session_dir" ] && [ "$state_workspace_session_dir" != "$host_project_session_dir" ]; then
      find "$state_workspace_session_dir" -maxdepth 1 -type f -name '*.jsonl' -exec cp -n {} "$host_project_session_dir/" \; 2>/dev/null || true
    fi
    session_bind_args=(--bind "$host_project_session_dir" "/home/pi/.pi/agent/sessions/$sandbox_session_dir_name")
  else
    echo "pi-en-bwrap: warning: could not prepare host project session dir: $host_project_session_dir" >&2
  fi
fi

coord_remote_bind_args=()
sandbox_coord_remote=""
coord_remote=""
coord_remote_source=""
if [ -n "${PI_EN_COORD_REMOTE:-}" ]; then
  coord_remote="$PI_EN_COORD_REMOTE"
  coord_remote_source="env"
else
  coord_remote="$(pi_bwrap_coord_config_value coordination_remote 2>/dev/null || true)"
  if [ -n "$coord_remote" ]; then
    coord_remote_source="config"
  fi
fi

if [ -n "$coord_remote" ]; then
  if coord_remote_local_candidate="$(pi_bwrap_remote_local_path "$coord_remote" 2>/dev/null)"; then
    coord_remote_file_scheme=0
    case "$coord_remote" in
      file://*) coord_remote_file_scheme=1 ;;
    esac
    case "$coord_remote_local_candidate" in
      /*)
        host_coord_remote_logical="$(realpath -sm "$coord_remote_local_candidate")"
        host_coord_remote="$(realpath -m "$coord_remote_local_candidate")"
        ;;
      *)
        host_coord_remote_logical="$(realpath -sm "$project_root/$coord_remote_local_candidate")"
        host_coord_remote="$(realpath -m "$project_root/$coord_remote_local_candidate")"
        ;;
    esac
    sandbox_coord_remote_logical=""
    case "$host_coord_remote_logical" in
      "$project_root")
        sandbox_coord_remote_logical="/workspace"
        ;;
      "$project_root"/*)
        sandbox_coord_remote_logical="/workspace${host_coord_remote_logical#"$project_root"}"
        ;;
    esac
    case "$host_coord_remote" in
      "$project_root")
        sandbox_coord_remote="/workspace"
        ;;
      "$project_root"/*)
        sandbox_coord_remote="/workspace${host_coord_remote#"$project_root"}"
        ;;
      *)
        if [ -z "$sandbox_coord_remote" ]; then
          host_coord_remote_base="$(basename "$host_coord_remote_logical")"
          if [ -n "$sandbox_coord_remote_logical" ] && [ "$coord_remote_source" = "config" ]; then
            if [ -d "$host_coord_remote/objects" ]; then
              coord_remote_mount_point="$(dirname "$sandbox_coord_remote_logical")"
              sandbox_coord_remote="$sandbox_coord_remote_logical"
              coord_remote_bind_args=(--dir /workspace/.pi-en --tmpfs /workspace/.pi-en/agent-remotes --dir "$sandbox_coord_remote" --bind "$host_coord_remote" "$sandbox_coord_remote")
              echo "pi-en-bwrap: coordination remote alias from project config mounted at $sandbox_coord_remote" >&2
            else
              sandbox_coord_remote="$coord_remote"
              echo "pi-en-bwrap: warning: external coordination_remote from project config is not an existing bare Git repo and will not be mounted: $coord_remote" >&2
            fi
          elif [ "$coord_remote_source" = "config" ]; then
            if [ -d "$host_coord_remote/objects" ]; then
              coord_remote_mount_point="/workspace/.pi-en/agent-remotes"
              sandbox_coord_remote="$coord_remote_mount_point/$host_coord_remote_base"
              coord_remote_bind_args=(--dir /workspace/.pi-en --tmpfs "$coord_remote_mount_point" --dir "$sandbox_coord_remote" --bind "$host_coord_remote" "$sandbox_coord_remote")
              echo "pi-en-bwrap: coordination remote from project config mounted at $sandbox_coord_remote" >&2
            else
              sandbox_coord_remote="$coord_remote"
              echo "pi-en-bwrap: warning: external coordination_remote from project config is not an existing bare Git repo and will not be mounted: $coord_remote" >&2
            fi
          elif [ -d "$host_coord_remote" ]; then
            coord_remote_mount_point="/agent-remotes"
            sandbox_coord_remote="$coord_remote_mount_point/$host_coord_remote_base"
            coord_remote_bind_args=(--dir "$coord_remote_mount_point" --dir "$sandbox_coord_remote" --bind "$host_coord_remote" "$sandbox_coord_remote")
            echo "pi-en-bwrap: coordination remote mounted at $sandbox_coord_remote" >&2
          else
            sandbox_coord_remote="$coord_remote"
            echo "pi-en-bwrap: warning: local PI_EN_COORD_REMOTE outside project cannot be mounted: $coord_remote" >&2
          fi
        fi
        ;;
    esac
    if [ "$coord_remote_file_scheme" = "1" ]; then
      case "$sandbox_coord_remote" in
        file://*) ;;
        *) sandbox_coord_remote="file://$sandbox_coord_remote" ;;
      esac
    fi
  else
    sandbox_coord_remote="$coord_remote"
  fi
fi

coord_bind_args=()
sandbox_coord_dir="/workspace/.pi-en/coordination"
host_coord_dir="$(realpath -sm "$project_root/.pi-en/coordination")"
coord_dir_explicit=0
coord_dir_source="default coordination dir"

resolve_project_coord_path() {
  local candidate
  candidate="$1"
  case "$candidate" in
    /workspace) realpath -sm "$project_root" ;;
    /workspace/*) realpath -sm "$project_root/${candidate#/workspace/}" ;;
    /*) realpath -sm "$candidate" ;;
    *) realpath -sm "$project_root/$candidate" ;;
  esac
}

require_project_local_coord_dir() {
  local candidate source resolved expected
  candidate="$1"
  source="$2"
  resolved="$(resolve_project_coord_path "$candidate")"
  expected="$(realpath -sm "$project_root/.pi-en/coordination")"
  if [ "$resolved" != "$expected" ]; then
    echo "pi-en-bwrap: $source must use the project-local coordination checkout: $expected" >&2
    exit 2
  fi
  if [ "$(realpath -m "$resolved")" != "$resolved" ]; then
    echo "pi-en-bwrap: $source must be a real project-local coordination checkout, not a symlink: $expected" >&2
    exit 2
  fi
  printf '%s' "$resolved"
}

if [ -n "${PI_EN_BWRAP_COORDINATION_DIR:-}" ]; then
  host_coord_dir="$(require_project_local_coord_dir "$PI_EN_BWRAP_COORDINATION_DIR" "PI_EN_BWRAP_COORDINATION_DIR")"
  coord_dir_explicit=1
  coord_dir_source="PI_EN_BWRAP_COORDINATION_DIR"
elif [ -n "${PI_EN_COORD_DIR:-}" ]; then
  host_coord_dir="$(require_project_local_coord_dir "$PI_EN_COORD_DIR" "PI_EN_COORD_DIR")"
  coord_dir_explicit=1
  coord_dir_source="PI_EN_COORD_DIR"
fi

if [ "$(realpath -m "$host_coord_dir")" != "$host_coord_dir" ]; then
  echo "pi-en-bwrap: coordination checkout must be a real project-local clone, not a symlink: $project_root/.pi-en/coordination" >&2
  exit 2
fi

if [ -d "$host_coord_dir" ]; then
  if [ -d "$host_coord_dir/.git" ] || [ -f "$host_coord_dir/AGENTS.md" ]; then
    echo "pi-en-bwrap: coordination repo available at $sandbox_coord_dir" >&2
    echo "pi-en-bwrap: pull/rebase before changing shared state" >&2
  fi
elif [ "$coord_dir_explicit" = "1" ]; then
  echo "pi-en-bwrap: warning: coordination dir not found for $coord_dir_source: $host_coord_dir" >&2
fi
refresh_generated_coordination_context

shell_interactive=0
bash_args_request_interactive() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --)
        return 1
        ;;
      --*)
        ;;
      -?*)
        case "$arg" in
          *i*) return 0 ;;
        esac
        ;;
    esac
  done
  return 1
}

if [ "$shell_mode" = "1" ]; then
  if [ "$#" -eq 0 ]; then
    pi_args=(-l)
    shell_interactive=1
  else
    pi_args=("$@")
    if bash_args_request_interactive "${pi_args[@]}"; then
      shell_interactive=1
    fi
  fi
  if [ "$shell_interactive" = "1" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    echo "pi-en-bwrap: interactive shell mode requires both stdin and stdout to be TTYs." >&2
    echo "pi-en-bwrap: run from a terminal/PTY, or pass explicit non-interactive Bash arguments such as: -- -lc 'pwd'." >&2
    exit 2
  fi
elif [ "$#" -eq 0 ]; then
  pi_args=(--tools "$DEFAULT_PI_TOOLS" --continue)
else
  pi_args=("$@")
fi

role_manager_bind_args=()
role_manager_bind_count=0
role_manager_resource_dir_added=0
rewritten_package_path=""
sandbox_path_for_host_resource() {
  local host_path="$1"
  case "$host_path" in
    "$project_root")
      rewritten_package_path=/workspace
      return 0
      ;;
    "$project_root"/*)
      rewritten_package_path="/workspace${host_path#"$project_root"}"
      return 0
      ;;
  esac
  if host_path_is_default_mounted "$host_path"; then
    rewritten_package_path="$host_path"
    return 0
  fi
  role_manager_bind_count=$((role_manager_bind_count + 1))
  rewritten_package_path="/pi-en-resources/role-manager-$role_manager_bind_count"
  if [ "$role_manager_resource_dir_added" = "0" ]; then
    role_manager_bind_args+=(--dir /pi-en-resources)
    role_manager_resource_dir_added=1
  fi
  role_manager_bind_args+=(--ro-bind "$host_path" "$rewritten_package_path")
}

rewrite_pi_package_path() {
  local package_path="$1"
  case "$package_path" in
    /*) ;;
    *) package_path="$(realpath -m "$PWD/$package_path")" ;;
  esac
  if [ ! -e "$package_path" ]; then
    rewritten_package_path="$1"
    return 0
  fi
  package_path="$(realpath -e "$package_path")"
  sandbox_path_for_host_resource "$package_path"
}

if [ "$shell_mode" = "0" ]; then
  rewritten_pi_args=()
  i=0
  while [ "$i" -lt "${#pi_args[@]}" ]; do
    arg="${pi_args[$i]}"
    case "$arg" in
      -e|--extension|--package)
        rewritten_pi_args+=("$arg")
        i=$((i + 1))
        if [ "$i" -lt "${#pi_args[@]}" ]; then
          rewrite_pi_package_path "${pi_args[$i]}"
          rewritten_pi_args+=("$rewritten_package_path")
        fi
        ;;
      --extension=*|--package=*)
        rewrite_pi_package_path "${arg#*=}"
        rewritten_pi_args+=("${arg%%=*}=$rewritten_package_path")
        ;;
      *)
        rewritten_pi_args+=("$arg")
        ;;
    esac
    i=$((i + 1))
  done
  pi_args=("${rewritten_pi_args[@]}")
fi

env_args=(--clearenv)

set_env() {
  env_args+=(--setenv "$1" "$2")
}

copy_env() {
  local name="$1"
  local value
  if value="$(printenv "$name" 2>/dev/null)" && [ -n "$value" ]; then
    set_env "$name" "$value"
  fi
}

set_env TERM "${TERM:-xterm-256color}"
copy_env COLORTERM
copy_env NO_COLOR
copy_env FORCE_COLOR

if [ "$shell_mode" = "1" ]; then
  if inherited_ps1="$(printenv PS1 2>/dev/null)" && [ -n "$inherited_ps1" ]; then
    set_env PS1 "$inherited_ps1"
  elif [ -n "${PI_EN_DEV_SHELL_PS1:-}" ]; then
    set_env PS1 "$PI_EN_DEV_SHELL_PS1"
  fi
  bwrap_dev_prompt_command='case "$-" in *i*) case "${PS1-}" in *"(bwrap-dev)"*) ;; *) PS1="(bwrap-dev) ${PS1-}" ;; esac ;; esac'
  if inherited_prompt_command="$(printenv PROMPT_COMMAND 2>/dev/null)" && [ -n "$inherited_prompt_command" ]; then
    set_env PROMPT_COMMAND "$bwrap_dev_prompt_command; $inherited_prompt_command"
  else
    set_env PROMPT_COMMAND "$bwrap_dev_prompt_command"
  fi
fi

