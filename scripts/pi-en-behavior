#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if command -v pi-en-behavior-python >/dev/null 2>&1; then
  python_runner="$(command -v pi-en-behavior-python)"
else
  python_runner="${PYTHON:-python3}"
fi
exec "$python_runner" "$script_dir/pi-en-behavior.py" "$@"
