#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export PYTHONPYCACHEPREFIX="${XDG_CACHE_HOME:-${HOME}/.cache}/pi-en/python-bytecode"
if ! command -v pi-en-behavior-python >/dev/null 2>&1; then
  printf '%s\n' \
    'pi-en behavior: Python runtime unavailable; rebuild and relaunch with `nix develop`.' >&2
  exit 1
fi
exec pi-en-behavior-python "$script_dir/pi-en-behavior.py" "$@"
